###############################################
# Detection Name : RDP Brute Force Detection
# Author         : Navin Maurya
# Platform       : Splunk Enterprise
# MITRE ATT&CK   : T1110.001 - Password Guessing
# Severity       : High
# Data Source    : Windows Security Event Logs
# Event ID       : 4625 (Failed Logon)
###############################################

# Description:
# Detects multiple failed Remote Desktop (RDP) authentication attempts
# from the same source IP within a short period of time.
#
# Threshold:
# - 5 or more failed logins
# - Within 5 minutes
#
# Output:
# Generates a high-severity alert that can be sent to Splunk SOAR.

index=main sourcetype="WinEventLog:Security" EventCode=4625 LogonType=10
| stats count AS failed_attempts
        values(Account_Name) AS targeted_users
        values(ComputerName) AS destination_host
        earliest(_time) AS first_attempt
        latest(_time) AS last_attempt
        by Source_Network_Address
| where failed_attempts >= 5
| eval first_attempt=strftime(first_attempt,"%Y-%m-%d %H:%M:%S")
| eval last_attempt=strftime(last_attempt,"%Y-%m-%d %H:%M:%S")
| eval severity="High"
| eval alert_name="RDP Brute Force Detected"
| rename Source_Network_Address AS src_ip
| table alert_name severity src_ip failed_attempts targeted_users destination_host first_attempt last_attempt
| sort - failed_attempts
